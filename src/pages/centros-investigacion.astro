---
import BaseLayout from '../layouts/BaseLayout.astro';
import DetailDialog from '@components/ui/DetailDialog.astro';
import PageHero from '@components/ui/PageHero.astro';
import { RESEARCH_CENTERS } from '@utils/inam-content';
---

<BaseLayout
  title="Centros de investigación | INAM"
  description="Centros de investigación del INAM, sus enfoques, coordinación, misión y visión."
>
  <PageHero
    kicker="Centros de investigación"
    title="Dos centros, una agenda científica conectada."
    intro="Unidades especializadas en biotecnología, biodiversidad y bioeconomía al servicio del territorio amazónico."
    image="/amazonas-waterfall.webp"
    imageAlt="Cascada rodeada de bosque amazónico"
  />

  <main class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <div class="grid gap-x-12 md:grid-cols-2">
      {RESEARCH_CENTERS.map((center) => (
        <DetailDialog
          id={`center-${center.slug}`}
          eyebrow={center.acronym}
          title={center.name}
          summary={center.focus}
          previewRows={[{ label: 'Coordinación', value: center.coordinator }]}
          actionLabel="Conocer el centro"
          rows={[
            { label: 'Coordinación', value: center.coordinator },
            { label: 'Misión', value: center.mission },
            { label: 'Visión', value: center.vision },
          ]}
        />
      ))}
    </div>

    <aside class="mt-14 rounded-2xl bg-[var(--color-surface)] p-6 text-sm leading-7 text-[var(--color-body)] sm:p-8">
      Los centros y grupos de investigación trabajan como unidades complementarias dentro de la Subdirección de Investigación, articulando conocimiento, formación y transferencia científica.
    </aside>
  </main>
</BaseLayout>
