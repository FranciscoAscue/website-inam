---
import { NAVIGATION, SITE } from '@config/site';
import { ExternalLink, Mail, MapPin } from 'lucide-react';
import { CONTACT } from '@utils/inam-content';
import { withBase } from '@utils/paths';
---

<footer class="bg-[#0e3028] text-white">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.25fr_.8fr_.85fr_1.1fr]">
      <div>
        <a href={withBase('/')} class="inline-block rounded-lg bg-white p-2">
          <img
            src={withBase('/LOGO INAM FINAL.png')}
            alt="INAM - Instituto de Investigación en Ingeniería Ambiental"
            class="h-12 w-auto"
          />
        </a>
        <p class="mt-5 max-w-sm text-sm leading-7 text-white/68">
          Instituto de Investigación en Ingeniería Ambiental de la Universidad Nacional Toribio Rodríguez de Mendoza de Amazonas.
        </p>
      </div>

      <nav aria-label="Navegación de pie de página">
        <h2 class="footer-title">Explorar</h2>
        <ul class="mt-5 space-y-3">
          {NAVIGATION.map((item) => (
            <li><a href={withBase(item.href)} class="footer-link">{item.name}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="footer-title">Investigación</h2>
        <ul class="mt-5 space-y-3">
          <li><a href={withBase('/centros-investigacion')} class="footer-link">BIOGEV y CIEBB</a></li>
          <li><a href={withBase('/grupos-investigacion')} class="footer-link">Grupos especializados</a></li>
          <li><a href={withBase('/publicaciones')} class="footer-link">Publicaciones científicas</a></li>
          <li><a href={withBase('/publicaciones#proyectos')} class="footer-link">Proyectos financiados</a></li>
        </ul>
      </div>

      <address class="not-italic">
        <h2 class="footer-title">Contacto</h2>
        <div class="mt-5 space-y-4 text-sm leading-6 text-white/72">
          <p class="flex gap-3"><MapPin className="mt-0.5 h-4 w-4 shrink-0 text-[#8bd3b9]" /><span>{CONTACT.campus}<br />{CONTACT.region}</span></p>
          <a href={`mailto:${CONTACT.email}`} class="flex items-center gap-3 hover:text-white"><Mail className="h-4 w-4 text-[#8bd3b9]" />{CONTACT.email}</a>
          <a href="https://untrm.edu.pe/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 hover:text-white">
            <ExternalLink className="h-4 w-4 text-[#8bd3b9]" />Portal institucional UNTRM
          </a>
        </div>
      </address>
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-white/12 pt-6 text-xs text-white/48 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {SITE.author}</p>
      <p>Investigación, innovación y compromiso con la Amazonía.</p>
    </div>
  </div>
</footer>
