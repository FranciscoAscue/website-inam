---
import { ArrowUpRight, ChevronLeft, ChevronRight } from 'lucide-react';

interface Publication {
  title: string;
  journal: string;
  year: number;
  doi: string;
  groups: string[];
}

interface Props {
  publications: Publication[];
}

const { publications } = Astro.props;
const pageSize = 6;
const totalPages = Math.ceil(publications.length / pageSize);
---

<div class="publication-browser" data-publication-browser data-page-size={pageSize}>
  <div class="mb-8 flex flex-col gap-4 border-b border-[var(--color-border)] pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="section-kicker">Biblioteca científica</p>
      <h2 class="section-title mt-3">Publicaciones del instituto</h2>
    </div>
    <label class="block sm:w-72">
      <span class="sr-only">Filtrar publicaciones por grupo</span>
      <select data-publication-filter class="w-full rounded-xl border border-[var(--color-border-strong)] bg-white px-4 py-3 text-sm text-[var(--color-ink)] outline-none focus:border-[var(--color-accent)]">
        <option value="">Todos los grupos</option>
        {[...new Set(publications.flatMap((publication) => publication.groups))].map((group) => (
          <option value={group}>{group}</option>
        ))}
      </select>
    </label>
  </div>

  <div class="grid gap-5 md:grid-cols-2" data-publication-list>
    {publications.map((publication, index) => (
      <article
        class="publication-card flex min-h-64 flex-col rounded-2xl border border-[var(--color-border)] bg-white p-6 shadow-[0_14px_45px_rgba(20,49,40,.06)]"
        data-publication-card
        data-index={index}
        data-groups={publication.groups.join('|')}
      >
        <div class="flex items-center justify-between gap-4 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-muted)]">
          <span>{publication.journal}</span>
          <span>{publication.year}</span>
        </div>
        <h3 class="mt-5 text-xl font-semibold leading-snug tracking-tight text-[var(--color-ink)]">{publication.title}</h3>
        <div class="mt-auto flex flex-wrap items-end justify-between gap-4 pt-6">
          <div class="flex flex-wrap gap-2">
            {publication.groups.map((group) => (
              <span class="rounded-full bg-[var(--color-surface-strong)] px-3 py-1 text-xs font-semibold text-[var(--color-accent-deep)]">{group}</span>
            ))}
          </div>
          <a
            href={`https://doi.org/${publication.doi}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-deep)] hover:text-[var(--color-accent)]"
          >
            Leer publicación <ArrowUpRight className="h-4 w-4" />
          </a>
        </div>
      </article>
    ))}
  </div>

  <p data-publication-empty class="hidden rounded-2xl border border-[var(--color-border)] bg-white p-8 text-center text-[var(--color-body)]">
    No hay publicaciones asociadas a este grupo.
  </p>

  <nav class="mt-9 flex items-center justify-between border-t border-[var(--color-border)] pt-6" aria-label="Paginación de publicaciones">
    <button type="button" data-page-prev class="pagination-button" aria-label="Página anterior">
      <ChevronLeft className="h-4 w-4" /> Anterior
    </button>
    <p class="text-sm text-[var(--color-muted)]">
      Página <strong data-current-page class="text-[var(--color-ink)]">1</strong> de <strong data-total-pages class="text-[var(--color-ink)]">{totalPages}</strong>
    </p>
    <button type="button" data-page-next class="pagination-button" aria-label="Página siguiente">
      Siguiente <ChevronRight className="h-4 w-4" />
    </button>
  </nav>
</div>

<script>
  const initializePublicationBrowsers = () => {
    document.querySelectorAll<HTMLElement>('[data-publication-browser]').forEach((browser) => {
      if (browser.dataset.bound === 'true') return;
      browser.dataset.bound = 'true';

      const cards = [...browser.querySelectorAll<HTMLElement>('[data-publication-card]')];
      const filter = browser.querySelector<HTMLSelectElement>('[data-publication-filter]');
      const previous = browser.querySelector<HTMLButtonElement>('[data-page-prev]');
      const next = browser.querySelector<HTMLButtonElement>('[data-page-next]');
      const currentLabel = browser.querySelector<HTMLElement>('[data-current-page]');
      const totalLabel = browser.querySelector<HTMLElement>('[data-total-pages]');
      const empty = browser.querySelector<HTMLElement>('[data-publication-empty]');
      const pageSize = Number(browser.dataset.pageSize ?? 6);
      let currentPage = 1;

      const render = () => {
        const selectedGroup = filter?.value ?? '';
        const visibleCards = cards.filter((card) => !selectedGroup || card.dataset.groups?.split('|').includes(selectedGroup));
        const totalPages = Math.max(1, Math.ceil(visibleCards.length / pageSize));
        currentPage = Math.min(currentPage, totalPages);

        cards.forEach((card) => card.classList.add('hidden'));
        visibleCards
          .slice((currentPage - 1) * pageSize, currentPage * pageSize)
          .forEach((card) => card.classList.remove('hidden'));

        empty?.classList.toggle('hidden', visibleCards.length > 0);
        if (currentLabel) currentLabel.textContent = String(currentPage);
        if (totalLabel) totalLabel.textContent = String(totalPages);
        if (previous) previous.disabled = currentPage === 1;
        if (next) next.disabled = currentPage === totalPages;
      };

      filter?.addEventListener('change', () => {
        currentPage = 1;
        render();
      });
      previous?.addEventListener('click', () => {
        currentPage = Math.max(1, currentPage - 1);
        render();
        browser.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      next?.addEventListener('click', () => {
        currentPage += 1;
        render();
        browser.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      const initialGroup = new URLSearchParams(window.location.search).get('grupo');
      if (initialGroup && filter && [...filter.options].some((option) => option.value === initialGroup)) {
        filter.value = initialGroup;
      }
      render();
    });
  };

  initializePublicationBrowsers();
  document.addEventListener('astro:page-load', initializePublicationBrowsers);
</script>
