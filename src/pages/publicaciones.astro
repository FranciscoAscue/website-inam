---
import BaseLayout from '../layouts/BaseLayout.astro';
import DetailDialog from '@components/ui/DetailDialog.astro';
import PageHero from '@components/ui/PageHero.astro';
import PublicationBrowser from '@components/ui/PublicationBrowser.astro';
import { frontmatter } from '../content/publicaciones.md';
import { RESEARCH_PROJECTS } from '@utils/inam-content';
import { withBase } from '@utils/paths';

interface Publication {
  title: string;
  journal: string;
  year: number;
  doi: string;
  groups: string[];
}

const publications = frontmatter.publications as Publication[];
---

<BaseLayout
  title="Publicaciones y proyectos | INAM"
  description="Publicaciones científicas y proyectos financiados de los grupos de investigación del INAM."
>
  <PageHero
    kicker="Producción científica"
    title="Conocimiento producido desde Amazonas."
    intro="Explora artículos científicos y proyectos que convierten la investigación en evidencia, innovación y soluciones para el territorio."
    image="/kuelap-amazonas.jpg"
    imageAlt="Complejo arqueológico de Kuélap rodeado de vegetación"
  />

  <main>
    <section id="publicaciones" class="bg-[#f9fbfa]">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
        <PublicationBrowser publications={publications} />
      </div>
    </section>

    <section id="proyectos" class="relative overflow-hidden border-b border-[var(--color-border)] bg-[var(--color-surface)]">
      <div class="absolute right-0 top-0 hidden h-full w-[32%] lg:block">
        <img src={withBase('/amazonas-waterfall.jpg')} alt="Bosque y cascada de Amazonas" class="h-full w-full object-cover opacity-20" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-surface)] to-transparent"></div>
      </div>
      <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
        <div class="grid gap-10 lg:grid-cols-[0.55fr_1.45fr]">
          <div>
            <p class="section-kicker">Proyectos financiados</p>
            <h2 class="section-title mt-4">Investigación que avanza con objetivos concretos.</h2>
            <p class="mt-5 max-w-sm text-sm leading-7 text-[var(--color-body)]">
              Siete proyectos vinculados a bioeconomía, microbiología, conservación, resiliencia climática y recursos genéticos.
            </p>
          </div>
          <div class="grid gap-x-10 md:grid-cols-2">
            {RESEARCH_PROJECTS.map((project, index) => (
              <DetailDialog
                id={`project-${index + 1}`}
                eyebrow={project.group}
                title={project.shortName ?? project.name}
                summary={project.name}
                previewRows={[{ label: 'Grupo responsable', value: project.group }]}
                actionLabel="Conocer el proyecto"
                rows={[
                  { label: 'Grupo', value: project.group },
                  { label: 'Código del proyecto', value: project.code },
                ]}
              />
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
