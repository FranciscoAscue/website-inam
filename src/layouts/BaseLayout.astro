---
import '../styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { SITE } from '@config/site';
import { stripBaseFromPathname, withBase } from '@utils/paths';

interface Props {
  title?: string;
  description?: string;
}

const currentPathname = stripBaseFromPathname(Astro.url.pathname);

const { 
  title = SITE.title, 
  description = SITE.description 
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="light" data-locale="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const requestedLocale = new URLSearchParams(window.location.search).get('lang');
        try {
          const savedTheme = localStorage.getItem('inam-theme');
          const savedLocale = localStorage.getItem('inam-locale');
          const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          const browserLocale = (navigator.languages || [navigator.language]).some((language) => /^en(?:-|$)/i.test(language)) ? 'en' : 'es';
          root.dataset.theme = savedTheme || systemTheme;
          root.dataset.locale = requestedLocale === 'en' || requestedLocale === 'es'
            ? requestedLocale
            : savedLocale || browserLocale;
          if (requestedLocale === 'en' || requestedLocale === 'es') {
            localStorage.setItem('inam-locale', requestedLocale);
          }
        } catch {
          root.dataset.theme = 'light';
          root.dataset.locale = requestedLocale === 'en' ? 'en' : 'es';
        }
        root.lang = root.dataset.locale || 'es';
      })();
    </script>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
  </head>
  <body class="flex min-h-screen flex-col bg-[var(--color-page)] font-sans text-[var(--color-ink)] antialiased">
    <Header currentPathname={currentPathname} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import englishTranslations from '@utils/en-translations.json';

      const root = document.documentElement;
      const translations = englishTranslations as Record<string, string>;
      const originalText = new WeakMap<Text, string>();
      const originalAttributes = new WeakMap<Element, Map<string, string>>();

      const localizedValue = (source: string, locale: string) => {
        if (locale !== 'en') return source;
        const key = source.trim();
        const articleCount = key.match(/^(\d+) artículos relacionados$/);
        if (articleCount) return `${articleCount[1]} related articles`;
        const publicationCount = key.match(/^(\d+) publicaciones relacionadas$/);
        if (publicationCount) return `${publicationCount[1]} related publications`;
        const leadMatch = key.match(/^Responsable: (.+)$/);
        if (leadMatch) return `Lead: ${leadMatch[1].replace(/^Mg\./, 'MSc')}`;
        const portraitMatch = key.match(/^Retrato de (.+)$/);
        if (portraitMatch) return `Portrait of ${portraitMatch[1]}`;
        const match = key.match(/^(\d+) publicaciones relacionadas · (\d+) (proyecto financiado|proyectos financiados)$/);
        if (match) {
          const projects = Number(match[2]);
          return `${match[1]} related publications · ${projects} funded ${projects === 1 ? 'project' : 'projects'}`;
        }
        return translations[key] ?? source;
      };

      const translateText = (node: Text) => {
        if (node.parentElement?.closest('[data-language-label]')) return;
        const source = originalText.get(node) ?? node.data;
        if (!originalText.has(node)) originalText.set(node, source);
        const fixedEnglish = node.parentElement?.getAttribute('data-locale-word-en');
        const translated = root.dataset.locale === 'en' && fixedEnglish
          ? fixedEnglish
          : localizedValue(source, root.dataset.locale || 'es');
        if (node.data !== translated) node.data = translated;
      };

      const translateAttributes = (element: Element) => {
        const names = ['alt', 'aria-label', 'placeholder', 'title'];
        let saved = originalAttributes.get(element);
        if (!saved) {
          saved = new Map<string, string>();
          originalAttributes.set(element, saved);
        }
        names.forEach((name) => {
          if (!element.hasAttribute(name)) return;
          if (!saved?.has(name)) saved?.set(name, element.getAttribute(name) || '');
          const source = saved?.get(name) || '';
          const translated = localizedValue(source, root.dataset.locale || 'es');
          if (element.getAttribute(name) !== translated) element.setAttribute(name, translated);
        });
      };

      const translateSubtree = (node: Node) => {
        const isElement = node instanceof Element;
        const hasLanguageControl = isElement
          && (node.matches('[data-language-toggle]') || Boolean(node.querySelector('[data-language-toggle]')));
        const hasThemeControl = isElement
          && (node.matches('[data-theme-toggle]') || Boolean(node.querySelector('[data-theme-toggle]')));
        if (node instanceof Text) translateText(node);
        if (isElement) translateAttributes(node as Element);
        const walker = document.createTreeWalker(node, NodeFilter.SHOW_TEXT);
        let textNode = walker.nextNode();
        while (textNode) {
          translateText(textNode as Text);
          textNode = walker.nextNode();
        }
        if (isElement) {
          (node as Element).querySelectorAll('*').forEach(translateAttributes);
        }
        if (hasLanguageControl) updateLanguageControls();
        if (hasThemeControl) updateThemeToggleLabels();
      };

      const updateLanguageControls = () => {
        const locale = root.dataset.locale || 'es';
        const nextLocale = locale === 'en' ? 'es' : 'en';
        const label = nextLocale === 'en' ? 'View this page in English' : 'Ver esta página en español';
        document.querySelectorAll<HTMLButtonElement>('[data-language-toggle]').forEach((button) => {
          button.setAttribute('aria-label', label);
          button.setAttribute('title', label);
          const text = button.querySelector('[data-language-label]');
          if (text) text.textContent = nextLocale.toUpperCase();
        });
      };

      const updateThemeToggleLabels = () => {
        const nextAction = root.dataset.locale === 'en'
          ? (root.dataset.theme === 'dark' ? 'Enable light theme' : 'Enable dark theme')
          : (root.dataset.theme === 'dark' ? 'Activar tema claro' : 'Activar tema oscuro');
        document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
          if (button.hasAttribute('data-theme-toggle-generic')) return;
          button.setAttribute('aria-label', nextAction);
          button.setAttribute('title', nextAction);
          const label = button.querySelector('[data-theme-label]');
          if (label) label.textContent = nextAction;
        });
      };

      const applyLocale = (locale: string) => {
        root.dataset.locale = locale;
        root.lang = locale;
        translateSubtree(document.body);
        const title = document.querySelector('head title');
        if (title) translateSubtree(title);
        document.querySelectorAll<HTMLMetaElement>('meta[name="description"], meta[name="title"], meta[property="og:title"], meta[property="og:description"], meta[property="twitter:title"], meta[property="twitter:description"]').forEach((meta) => {
          const original = originalAttributes.get(meta) ?? new Map<string, string>();
          originalAttributes.set(meta, original);
          const key = 'content';
          if (!original.has(key)) original.set(key, meta.content);
          meta.content = localizedValue(original.get(key) || '', locale);
        });
        document.title = title?.textContent || document.title;
        updateLanguageControls();
        updateThemeToggleLabels();
      };

      applyLocale(root.dataset.locale || 'es');

      const languageObserver = new MutationObserver((records) => {
        records.forEach((record) => {
          record.addedNodes.forEach(translateSubtree);
          if (record.type === 'characterData' && record.target instanceof Text) translateText(record.target);
        });
      });
      languageObserver.observe(document.body, { childList: true, characterData: true, subtree: true });

      updateThemeToggleLabels();
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const languageButton = target.closest<HTMLButtonElement>('[data-language-toggle]');
        if (languageButton) {
          const nextLocale = root.dataset.locale === 'en' ? 'es' : 'en';
          try {
            localStorage.setItem('inam-locale', nextLocale);
          } catch {
            // The current page can still switch languages without storage.
          }
          const url = new URL(window.location.href);
          url.searchParams.set('lang', nextLocale);
          window.history.replaceState({}, '', url);
          applyLocale(nextLocale);
          return;
        }

        const button = target.closest<HTMLButtonElement>('[data-theme-toggle]');
        if (!button) return;

        const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.classList.add('theme-changing');
        root.dataset.theme = nextTheme;
        try {
          localStorage.setItem('inam-theme', nextTheme);
        } catch {
          // Keep the selected theme for this page even when storage is unavailable.
        }
        updateThemeToggleLabels();
        window.setTimeout(() => root.classList.remove('theme-changing'), 260);
      });
    </script>
  </body>
</html>
