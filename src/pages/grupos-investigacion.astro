---
import BaseLayout from '../layouts/BaseLayout.astro';
import DetailDialog from '@components/ui/DetailDialog.astro';
import PageHero from '@components/ui/PageHero.astro';
import { frontmatter } from '../content/publicaciones.md';
import { projectCountForGroup, RESEARCH_GROUPS } from '@utils/inam-content';
import { withBase } from '@utils/paths';
---

<BaseLayout
  title="Grupos de investigación | INAM"
  description="Siete grupos de investigación del INAM con sus líneas, responsables, publicaciones y proyectos asociados."
>
  <PageHero
    kicker="Grupos de investigación"
    title="Siete equipos, distintas formas de estudiar la biodiversidad."
    intro="Conoce sus líneas de trabajo, responsables, publicaciones y proyectos de investigación."
    image="/sonche-canyon-chachapoyas.jpg"
    imageAlt="Paisaje del cañón del Sonche en Chachapoyas"
  />

  <main class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <div class="grid gap-x-12 md:grid-cols-2 lg:grid-cols-3">
      {RESEARCH_GROUPS.map((group) => {
        const projectCount = projectCountForGroup(group.acronym);
        const publicationCount = frontmatter.publications.filter((publication: { groups: string[] }) =>
          publication.groups.includes(group.acronym),
        ).length;
        return (
          <DetailDialog
            id={`group-${group.slug}`}
            eyebrow={group.acronym}
            title={group.name}
            summary={group.summary}
            previewRows={[
              ...(group.lead ? [{ label: 'Responsable', value: group.lead }] : []),
              { label: 'Publicaciones', value: `${publicationCount} artículos relacionados` },
            ]}
            actionLabel="Abrir ficha"
            rows={[
              ...(group.lead ? [{ label: 'Responsable', value: group.lead }] : []),
              {
                label: 'Producción',
                value: `${publicationCount} publicaciones relacionadas · ${projectCount} ${projectCount === 1 ? 'proyecto financiado' : 'proyectos financiados'}`,
              },
            ]}
          />
        );
      })}
    </div>
    <div class="mt-12 flex flex-col gap-4 rounded-2xl bg-[var(--color-surface-strong)] p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <p class="max-w-2xl text-sm leading-7 text-[var(--color-body)]">Explora los artículos científicos y proyectos vinculados a estos equipos de investigación.</p>
      <a href={withBase('/publicaciones')} class="button-primary shrink-0">Ver publicaciones</a>
    </div>
  </main>
</BaseLayout>
