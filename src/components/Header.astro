---
import { NAVIGATION } from '@config/site';
import MobileMenu from '@components/react/MobileMenu';
import ThemeToggle from '@components/ui/ThemeToggle.astro';
import LanguageToggle from '@components/ui/LanguageToggle.astro';
import { withBase } from '@utils/paths';

const { currentPathname } = Astro.props;
const normalizePath = (pathname: string): string => {
  const normalized = pathname.replace(/\/+$/, '');
  return normalized || '/';
};

const isActiveLink = (href: string) : boolean => {
  const [path] = href.split('#');
  if (!path) return false;
  return normalizePath(currentPathname) === normalizePath(path);
};

---

<header class="site-header sticky top-0 z-50 w-full border-b border-[var(--color-border)] backdrop-blur-md">
  <nav class="container mx-auto flex h-[4.5rem] items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <div class="flex items-center">
      <a href={withBase('/')} class="logo-frame group flex items-center rounded-lg bg-white p-1.5 ring-1 ring-[var(--color-border)]">
        <img
          src={withBase('/LOGO INAM FINAL.png')}
          alt="INAM - Instituto de Investigación en Ingeniería Ambiental"
          class="h-10 w-auto transition-opacity group-hover:opacity-80 sm:h-11"
        />
      </a>
    </div>

    <!-- Desktop Navigation -->
    <div class="hidden xl:flex xl:items-center xl:space-x-1">
      {NAVIGATION.map((item) => {
        const isActive = isActiveLink(item.href);
        return (
        <a
          href={withBase(item.href)}
          class={`relative px-3 py-2 text-sm font-medium text-[var(--color-body)] transition-colors hover:text-[var(--color-accent-deep)] ${isActive ? 'nav-active' : ''}`}
        >
          {item.name}
        </a>
      );
      })}
    </div>

    <!-- CTA Button -->
    <div class="hidden xl:flex xl:items-center xl:space-x-4">
      <a
        href={withBase('/#contacto')}
        class="button-primary px-5 py-2.5"
      >
        Contacto
      </a>
      <LanguageToggle />
      <ThemeToggle />
    </div>

    <!-- Mobile Menu Button -->
    <MobileMenu client:idle />
  </nav>
</header>
