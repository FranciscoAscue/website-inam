---
import { ArrowUpRight, X } from 'lucide-react';

interface DetailRow {
  label: string;
  value: string;
}

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  summary: string;
  previewRows?: DetailRow[];
  rows?: DetailRow[];
  tags?: string[];
  links?: { label: string; href: string }[];
  actionLabel?: string;
}

const {
  id,
  eyebrow,
  title,
  summary,
  previewRows = [],
  rows = [],
  tags = [],
  links = [],
  actionLabel = 'Ver detalles',
} = Astro.props;
---

<article class="group flex h-full flex-col border-t border-[var(--color-border)] py-7">
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-accent)]">{eyebrow}</p>
  <h2 class="mt-3 max-w-xl text-xl font-semibold leading-snug tracking-tight text-[var(--color-ink)] sm:text-2xl">
    {title}
  </h2>
  <p class="mt-3 line-clamp-3 text-sm leading-6 text-[var(--color-body)]">{summary}</p>
  {previewRows.length > 0 && (
    <dl class="mt-5 space-y-2 border-l-2 border-[var(--color-border-strong)] pl-4">
      {previewRows.map((row) => (
        <div>
          <dt class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-muted)]">{row.label}</dt>
          <dd class="mt-0.5 text-sm font-medium leading-5 text-[var(--color-ink)]">{row.value}</dd>
        </div>
      ))}
    </dl>
  )}
  <button
    type="button"
    data-dialog-open={id}
    class="mt-6 inline-flex w-fit items-center gap-2 text-sm font-semibold text-[var(--color-accent-deep)] transition-colors hover:text-[var(--color-accent)]"
    aria-haspopup="dialog"
  >
    {actionLabel}
    <ArrowUpRight className="h-4 w-4" />
  </button>
</article>

<dialog
  id={id}
  class="detail-dialog m-auto w-[calc(100%-2rem)] max-w-2xl rounded-2xl border border-[var(--color-border)] bg-white p-0 text-[var(--color-ink)] shadow-2xl backdrop:bg-[#102c28]/70 backdrop:backdrop-blur-sm"
  aria-labelledby={`${id}-title`}
>
  <div class="max-h-[min(82vh,760px)] overflow-y-auto p-6 sm:p-9">
    <div class="flex items-start justify-between gap-6">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-accent)]">{eyebrow}</p>
        <h2 id={`${id}-title`} class="mt-3 text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">
          {title}
        </h2>
      </div>
      <button
        type="button"
        data-dialog-close
        class="-mr-2 -mt-2 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-[var(--color-muted)] transition-colors hover:bg-[var(--color-surface)] hover:text-[var(--color-ink)]"
        aria-label="Cerrar ventana"
      >
        <X className="h-5 w-5" />
      </button>
    </div>

    <p class="mt-6 text-base leading-7 text-[var(--color-body)]">{summary}</p>

    {rows.length > 0 && (
      <dl class="mt-8 divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
        {rows.map((row) => (
          <div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr] sm:gap-5">
            <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-muted)]">{row.label}</dt>
            <dd class="text-sm leading-6 text-[var(--color-ink)]">{row.value}</dd>
          </div>
        ))}
      </dl>
    )}

    {tags.length > 0 && (
      <div class="mt-7">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-muted)]">Publicaciones relacionadas</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="rounded-full bg-[var(--color-surface)] px-3 py-1.5 font-mono text-xs text-[var(--color-body)]">
              {tag}
            </span>
          ))}
        </div>
      </div>
    )}

    {links.length > 0 && (
      <div class="mt-7 flex flex-wrap gap-x-5 gap-y-3">
        {links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-deep)] hover:text-[var(--color-accent)]"
          >
            {link.label}
            <ArrowUpRight className="h-4 w-4" />
          </a>
        ))}
      </div>
    )}
  </div>
</dialog>

<script>
  const bindDetailDialogs = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-dialog-open]').forEach((trigger) => {
      if (trigger.dataset.bound === 'true') return;
      trigger.dataset.bound = 'true';
      trigger.addEventListener('click', () => {
        const dialogId = trigger.dataset.dialogOpen;
        const dialog = dialogId ? document.getElementById(dialogId) : null;
        if (dialog instanceof HTMLDialogElement) dialog.showModal();
      });
    });

    document.querySelectorAll<HTMLDialogElement>('.detail-dialog').forEach((dialog) => {
      if (dialog.dataset.bound === 'true') return;
      dialog.dataset.bound = 'true';
      dialog.querySelector<HTMLButtonElement>('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  };

  bindDetailDialogs();
  document.addEventListener('astro:page-load', bindDetailDialogs);
</script>
