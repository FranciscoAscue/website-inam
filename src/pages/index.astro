---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, BookOpen, Building2, ExternalLink, Mail, MapPin, Network, Users } from 'lucide-react';
import { frontmatter } from '../content/publicaciones.md';
import { CONTACT, RESEARCH_CENTERS, RESEARCH_GROUPS, RESEARCH_PROJECTS } from '@utils/inam-content';
import { withBase } from '@utils/paths';

const metrics = [
  { value: RESEARCH_CENTERS.length, label: 'centros de investigación' },
  { value: RESEARCH_GROUPS.length, label: 'grupos especializados' },
  { value: frontmatter.publications.length, label: 'publicaciones científicas' },
  { value: RESEARCH_PROJECTS.length, label: 'proyectos financiados' },
];

const routes = [
  {
    title: 'Centros de investigación',
    text: 'Biotecnología, genómica vegetal, biodiversidad y bioeconomía.',
    href: '/centros-investigacion',
    image: '/amazonas-waterfall.jpg',
    imageAlt: 'Cascada en el bosque amazónico',
    icon: Building2,
  },
  {
    title: 'Grupos de investigación',
    text: 'Siete equipos que estudian los desafíos ambientales y productivos del territorio.',
    href: '/grupos-investigacion',
    image: '/sonche-canyon-chachapoyas.jpg',
    imageAlt: 'Vista del cañón del Sonche',
    icon: Users,
  },
  {
    title: 'Publicaciones y proyectos',
    text: 'Resultados científicos, artículos y proyectos desarrollados desde Amazonas.',
    href: '/publicaciones',
    image: '/kuelap-amazonas.jpg',
    imageAlt: 'Complejo arqueológico de Kuélap',
    icon: BookOpen,
  },
];
---

<BaseLayout
  title="INAM | Investigación para la biodiversidad y el territorio"
  description="Centros, grupos y producción científica del Instituto de Investigación en Ingeniería Ambiental de la UNTRM."
>
  <section class="relative isolate min-h-[80vh] overflow-hidden bg-[#123a31] text-white">
    <video
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={withBase('/amazonas-river-peru.jpg')}
      aria-hidden="true"
    >
      <source src={withBase('/chachapoyas-amazonas-hero.mp4')} type="video/mp4" />
    </video>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(8,35,29,.94)_0%,rgba(8,35,29,.78)_52%,rgba(8,35,29,.30)_100%)]"></div>

    <div class="mx-auto flex min-h-[80vh] max-w-7xl items-center px-4 py-20 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#b5e7d5]">Instituto de Investigación en Ingeniería Ambiental</p>
        <h1 class="mt-6 text-4xl font-semibold leading-[1.05] tracking-[-0.045em] sm:text-6xl lg:text-7xl">
          Ciencia para comprender y cuidar nuestro territorio.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/82 sm:text-xl">
          Investigación, formación y transferencia en biodiversidad, biotecnología y bioeconomía desde Amazonas para el Perú.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={withBase('/grupos-investigacion')} class="button-primary button-on-dark">
            Conocer los grupos <ArrowRight className="h-4 w-4" />
          </a>
          <a href={withBase('/publicaciones')} class="button-secondary button-secondary-dark">Ver publicaciones</a>
        </div>
      </div>
    </div>
  </section>

  <section aria-label="Resumen institucional" class="relative z-10 -mt-px border-b border-[var(--color-border)] bg-white">
    <div class="mx-auto grid max-w-7xl grid-cols-2 px-4 sm:px-6 lg:grid-cols-4 lg:px-8">
      {metrics.map((metric) => (
        <div class="border-[var(--color-border)] px-3 py-7 even:border-l lg:border-l">
          <p class="text-3xl font-semibold tracking-tight text-[var(--color-ink)]">{metric.value}</p>
          <p class="mt-1 text-sm text-[var(--color-muted)]">{metric.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="max-w-2xl">
      <p class="section-kicker">Explora el INAM</p>
      <h2 class="section-title mt-4">Investigación organizada para generar impacto.</h2>
    </div>
    <div class="mt-11 grid gap-6 md:grid-cols-3">
      {routes.map(({ title, text, href, image, imageAlt, icon: Icon }) => (
        <a href={withBase(href)} class="group overflow-hidden rounded-2xl border border-[var(--color-border)] bg-white shadow-[0_18px_55px_rgba(20,49,40,.08)] transition-transform duration-300 hover:-translate-y-1">
          <div class="relative h-48 overflow-hidden">
            <img src={withBase(image)} alt={imageAlt} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0d3027]/55 to-transparent"></div>
            <span class="absolute bottom-4 left-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white text-[var(--color-accent-deep)] shadow-lg">
              <Icon className="h-5 w-5" />
            </span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold tracking-tight text-[var(--color-ink)]">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-[var(--color-body)]">{text}</p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-deep)]">
              Explorar <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-1" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="overflow-hidden bg-[var(--color-surface)]">
    <div class="mx-auto grid max-w-7xl lg:grid-cols-2">
      <div class="relative min-h-[26rem]">
        <img src={withBase('/amazonas-river-peru.jpg')} alt="Río entre bosques y montañas de Amazonas" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
      </div>
      <div class="flex items-center px-6 py-16 sm:px-10 lg:px-16 lg:py-24">
        <div>
          <Network className="h-7 w-7 text-[var(--color-accent)]" />
          <p class="section-kicker mt-6">Ciencia y territorio</p>
          <h2 class="section-title mt-4">Investigación conectada con la Amazonía.</h2>
          <p class="mt-6 text-base leading-8 text-[var(--color-body)]">
            El INAM articula ciencias naturales, tecnología y economía para producir conocimiento útil frente a los retos de la biodiversidad, la producción sostenible y el cambio climático.
          </p>
          <a href={withBase('/organizacion')} class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-deep)]">
            Conocer nuestra organización <ArrowRight className="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="contacto" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="overflow-hidden rounded-3xl border border-[var(--color-border)] bg-white shadow-[0_22px_70px_rgba(20,49,40,.10)]">
      <div class="grid lg:grid-cols-[0.78fr_1.22fr]">
        <div class="bg-[#123a31] p-8 text-white sm:p-10 lg:p-12">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#a9e2cf]">Contacto institucional</p>
          <h2 class="mt-5 text-3xl font-semibold tracking-tight">Estamos en Chachapoyas.</h2>
          <p class="mt-5 text-sm leading-7 text-white/70">
            Comunícate con la Universidad Nacional Toribio Rodríguez de Mendoza de Amazonas para consultas institucionales y de investigación.
          </p>
        </div>
        <address class="grid gap-7 p-8 not-italic sm:grid-cols-2 sm:p-10 lg:p-12">
          <div class="flex gap-4">
            <span class="contact-icon"><MapPin className="h-5 w-5" /></span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-[var(--color-muted)]">Dirección</p>
              <p class="mt-2 text-sm leading-6 text-[var(--color-ink)]">{CONTACT.campus}<br />{CONTACT.region}</p>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="contact-icon"><Mail className="h-5 w-5" /></span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-[var(--color-muted)]">Correo</p>
              <a href={`mailto:${CONTACT.email}`} class="mt-2 block text-sm font-semibold text-[var(--color-accent-deep)] hover:text-[var(--color-accent)]">{CONTACT.email}</a>
            </div>
          </div>
          <div class="sm:col-span-2 border-t border-[var(--color-border)] pt-6">
            <a href="https://untrm.edu.pe/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-deep)]">
              Visitar portal institucional UNTRM <ExternalLink className="h-4 w-4" />
            </a>
          </div>
        </address>
      </div>
    </div>
  </section>
</BaseLayout>
